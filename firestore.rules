rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId}
    // Fields:
    //   - uid: string (required) - The unique ID of the user.
    //   - displayName: string (optional) - The display name of the user.
    //   - email: string (required, email format) - The email address of the user.
    //   - photoURL: string (optional, URL format) - The profile picture URL.
    //   - role: string (required, enum: ['user', 'admin']) - The user's role.
    //   - createdAt: timestamp (required) - When the profile was created.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == "matheusmagoi26@gmail.com";
    }

    function isValidEmail(email) {
      return email is string && email.matches("^.+@.+$");
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*"));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['user', 'admin'] &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidOrder(data) {
      return hasOnlyAllowedFields(['userId', 'items', 'total', 'status', 'trackingNumber', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             (data.trackingNumber == null || (data.trackingNumber is string && data.trackingNumber.size() <= 100)) &&
             (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidOrder(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /newsletter/{email} {
      allow read: if isAdmin();
      allow create: if incoming().email == email && 
                    incoming().email is string &&
                    incoming().createdAt == request.time &&
                    incoming().get('status', 'active') == 'active';
      allow update, delete: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if isValidContact(incoming()) && isValidId(contactId);
      allow read, update, delete: if isAdmin();
    }

    function isValidContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.matches("^.+@.+$") && data.email.size() <= 200 &&
             data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.createdAt == request.time;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
