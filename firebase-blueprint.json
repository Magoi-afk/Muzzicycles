{
  "entities": {
    "users": {
      "title": "User Profile",
      "description": "User profile information stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The unique ID of the user." },
        "displayName": { "type": "string", "description": "The display name of the user." },
        "email": { "type": "string", "format": "email", "description": "The email address of the user." },
        "photoURL": { "type": "string", "format": "uri", "description": "The profile picture URL of the user." },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "The role of the user." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email"]
    },
    "orders": {
      "title": "Order",
      "description": "Order information stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "total", "status"]
    },
    "newsletter": {
      "title": "Newsletter Subscription",
      "description": "Email subscriptions for the newsletter.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["active", "unsubscribed"] }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "Collection of user profiles."
    },
    "/orders/{orderId}": {
      "schema": "orders",
      "description": "Collection of orders."
    },
    "/newsletter/{email}": {
      "schema": "newsletter",
      "description": "Collection of newsletter subscriptions."
    }
  }
}
